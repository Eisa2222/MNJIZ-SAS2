{
    "name": "laravel/laravel",
    "type": "project",
    "description": "The skeleton application for the Laravel framework.",
    "keywords": [
        "laravel",
        "framework"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.1",
        "ab-alselwi/laravel-arabic-html": "*",
        "abraham/twitteroauth": "^7.0",
        "alkoumi/laravel-hijri-date": "^1.0",
        "barryvdh/laravel-snappy": "^1.0",
        "brian2694/laravel-toastr": "^5.59",
        "carlos-meneses/laravel-mpdf": "2.1.13",
        "ezyang/htmlpurifier": "^4.18",
        "genealabs/laravel-model-caching": "^12.0",
        "intervention/image": "^3.9",
        "laravel/framework": "^10.0",
        "laravel/sanctum": "^3.3",
        "laravel/socialite": "^5.16",
        "laravel/tinker": "^2.9",
        "league/commonmark": "^2.7",
        "league/oauth2-client": "^2.7",
        "livewire/livewire": "^3.5",
        "maatwebsite/excel": "^3.1",
        "microsoft/microsoft-graph": "^1.67",
        "mpdf/mpdf": "^8.2",
        "pharaonic/laravel-hijri": "^2.1",
        "phpoffice/phpword": "^1.4",
        "propaganistas/laravel-phone": "^5.3",
        "psr/http-message": "^1.0",
        "pusher/pusher-php-server": "^7.2",
        "simplesoftwareio/simple-qrcode": "^4.2",
        "smalot/pdfparser": "^2.11",
        "socialiteproviders/microsoft": "^4.5",
        "spatie/laravel-activitylog": "^4.8",
        "spatie/laravel-permission": "^6.9",
        "stancl/tenancy": "^3.8",
        "tinybutstrong/opentbs": "^1.12",
        "tinybutstrong/tinybutstrong": "^3.15",
        "twilio/sdk": "^8.3",
        "yajra/laravel-datatables": "^9.0",
        "yajra/laravel-datatables-html": "^9.4",
        "yajra/laravel-datatables-oracle": "^10.11"
    },
    "require-dev": {
        "barryvdh/laravel-debugbar": "^3.14",
        "fakerphp/faker": "^1.23",
        "laravel/breeze": "^1.29",
        "laravel/pint": "^1.13",
        "laravel/sail": "^1.26",
        "laravel/telescope": "^5.7",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^7.0",
        "phpunit/phpunit": "^10.5",
        "spatie/laravel-ignition": "^2.4"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/",
              "App\\Helpers\\": "app/Helpers/"
        },
        "files": [
            "app/Helpers/Helpers.php"
        ]
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --graceful --ansi"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true,
            "tbachert/spi": false
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
