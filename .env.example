APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# ============================================================================
# Multi-Tenancy (Phase 2 — SaaS foundation)
# ============================================================================
# single_database: all tenants share one DB, isolated by tenant_id + scopes.
TENANCY_MODE=single_database

# path: /t/{tenant}/... (Phase A)    |    subdomain: {tenant}.domain (Phase B)
TENANCY_DRIVER=path

# Compatibility during migration: legacy /employees/* routes use Default Tenant.
# Turn OFF once all traffic flows through /t/{tenant} (end of Phase 6).
TENANCY_FALLBACK_ENABLED=true
TENANCY_DEFAULT_TENANT_SLUG=default
TENANCY_DEFAULT_TENANT_ID=1

# Strict: throw if any tenant-aware query runs without a tenant resolved.
# Keep FALSE in dev and Phase 2; enable in staging around Phase 6.
TENANCY_STRICT=false

# ============================================================================
# Super Admin bootstrap (Phase 3)
# ============================================================================
# Used ONCE by DefaultAdminSeeder. Change the password after first login.
SUPER_ADMIN_EMAIL=super@mnjiz.sa
SUPER_ADMIN_PASSWORD=ChangeMeImmediately!

# ============================================================================
# Billing (Phase 4) — Plans / Features / Usage
# ============================================================================
# Plan auto-assigned to new tenants (slug must exist in plans table).
BILLING_DEFAULT_PLAN_SLUG=free
BILLING_CURRENCY=SAR
