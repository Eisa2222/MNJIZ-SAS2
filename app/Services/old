    /**
     * Update a task in a user's Todo list
     *
     * @param  string  $userId
     * @param  string  $graphTaskId
     * @return TodoTask|array
     */
    public function updateTaskForUser($userId, $graphTaskId, array $taskData)
    {
        if (! $this->accessToken) {
            return ['error' => 'Access token is missing.'];
        }

        try {
            // إعداد بيانات المهمة المحدثة
            $updatedTask = [
                'subject' => $taskData['subject'] ?? 'مهمة محدثة',
                'dueDateTime' => [
                    'dateTime' => $taskData['endDateTime'] ?? null,
                    'timeZone' => 'Asia/Riyadh',
                ],
                'body' => [
                    'content' => $taskData['body'] ?? '',
                    'contentType' => 'text',
                ],
                // إضافة أي حقول أخرى تحتاج إلى تحديثها
            ];

            // إرسال طلب تحديث المهمة
            $response = $this->graph->createRequest('PATCH', "/users/{$userId}/todo/lists/{$taskData['list_id']}/tasks/{$graphTaskId}")
                ->attachBody($updatedTask)
                ->setReturnType(TodoTask::class)
                ->execute();

            Log::info("Task updated successfully in Microsoft Graph for user {$userId}: " . json_encode($response));

            return $response;
        } catch (\Microsoft\Graph\Exception\GraphException $e) {
            Log::error("GraphException updating task for user {$userId}: " . $e->getMessage());

            return ['error' => $e->getMessage()];
        } catch (\Exception $e) {
            Log::error("Error updating task for user {$userId}: " . $e->getMessage());

            return ['error' => $e->getMessage()];
        }
    }

