    public function __construct(MicrosoftGraphBaseService $graphService)
    {
        parent::__construct();


        // Obtain app access token
        $this->accessToken = $graphService->getAppAccessToken();

        if (! $this->accessToken) {
            Log::error('Failed to obtain application access token.');
            // يمكنك رمي استثناء أو التعامل مع الحالة بناءً على متطلباتك
        }

        // Set access token in Graph
        $this->setGraphAccessToken($this->accessToken);

        // Initialize Guzzle Client for batch requests
        $this->graphClient = new Client([
            'base_uri' => 'https://graph.microsoft.com/v1.0/',
            'headers' => [
                'Authorization' => 'Bearer ' . $this->accessToken,
                'Content-Type' => 'application/json',
                'Accept' => 'application/json',
            ],
        ]);
    }

    /**
     * Get or create a Todo list for a user and return its ID
     *
     * @param  string  $userId
     * @param  string  $listName
     * @return string|array Returns the list ID or an error array
     */
    public function getOrCreateTodoListId($userId, $listName)
    {
        if (! $this->accessToken) {
            return ['error' => 'Access token is missing.'];
        }

        try {
            // Fetch user's Todo lists
            $lists = $this->graph->createRequest('GET', "/users/{$userId}/todo/lists")
                ->setReturnType(TodoTaskList::class)
                ->execute();

            Log::info("Fetched todo lists for user {$userId}: ", ['lists' => $lists]);

            // Search for the list with the specified name
            foreach ($lists as $list) {
                if ($list->getDisplayName() === $listName) {
                    return $list->getId();
                }
            }

            // If list not found, create it
            $newList = $this->createTodoList($userId, $listName);
            if (is_array($newList) && isset($newList['error'])) {
                return $newList; // Return error if occurred during creation
            }

            return $newList->getId();
        } catch (\Exception $e) {
            Log::error("Error getting or creating Todo list '{$listName}' for user {$userId}: " . $e->getMessage());

            return ['error' => $e->getMessage()];
        }
    }

    /**
     * Create a new Todo list for a user
     *
     * @param  string  $userId
     * @param  string  $listName
     * @return TodoTaskList|array
     */
    public function createTodoList($userId, $listName)
    {
        if (! $this->accessToken) {
            return ['error' => 'Access token is missing.'];
        }

        try {
            $list = [
                'displayName' => $listName,
            ];

            $response = $this->graph->createRequest('POST', "/users/{$userId}/todo/lists")
                ->attachBody($list)
                ->setReturnType(TodoTaskList::class)
                ->execute();

            Log::info("Todo list '{$listName}' created successfully for user {$userId}: " . json_encode($response));

            return $response;
        } catch (\Exception $e) {
            Log::error("Error creating Todo list '{$listName}' for user {$userId}: " . $e->getMessage());

            return ['error' => $e->getMessage()];
        }
    }

    /**
     * Add a task to a user's Todo list
     *
     * @param  string  $userId
     * @param  string  $listName
     * @return TodoTask|array
     */
    public function addTaskToUser($userId, array $taskData, $listName = 'البرهان')
    {
        if (! $this->accessToken) {
            return ['error' => 'Access token is missing.'];
        }

        try {
            // Get or create the Todo list ID
            $todoListId = $this->getOrCreateTodoListId($userId, $listName);
            if (is_array($todoListId) && isset($todoListId['error'])) {
                return $todoListId; // Return error if occurred
            }

            // Prepare task data
            $task = [
                'title' => $taskData['subject'] ?? 'مهمة جديدة',
                'dueDateTime' => [
                    'dateTime' => $taskData['endDateTime'] ?? null,
                    'timeZone' => 'Asia/Riyadh',
                ],
                'body' => [
                    'content' => $taskData['body'] ?? '',
                    'contentType' => 'text',
                ],
                // Additional fields as needed
            ];

            // Create the task
            $response = $this->graph->createRequest('POST', "/users/{$userId}/todo/lists/{$todoListId}/tasks")
                ->attachBody($task)
                ->setReturnType(TodoTask::class)
                ->execute();

            // Log the response
            Log::info("Task added successfully to list '{$listName}' for user {$userId}: " . json_encode($response));

            // return $response;
            return [
                'list_id' => $todoListId,
                'task' => $response,
            ];
        } catch (\Exception $e) {
            Log::error("Error adding task to user {$userId}: " . $e->getMessage());

            return ['error' => $e->getMessage()];
        }
    }



