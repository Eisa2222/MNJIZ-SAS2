    /**
     * Send a batch request to Microsoft Graph API
     *
     * @return array
     */
    protected function sendBatchRequest(array $headers, array $batchRequests)
    {
        log::info('start sendBatchRequest');

        // Prepare batch request body
        $batchBody = [
            'requests' => $batchRequests,
        ];

        try {
            $response = $this->graphClient->post('$batch', [
                'headers' => $headers,
                'json' => $batchBody,
            ]);

            $responseBody = json_decode($response->getBody()->getContents(), true);

            return $responseBody['responses'] ?? [];
        } catch (\Exception $e) {
            Log::error('Error sending batch request: ' . $e->getMessage());
            throw $e;
        }
    }

    /**
     * حذف مهمة في Microsoft Graph
     *
     * @param  string  $userId
     * @param  string  $graphTaskId
     * @return bool
     */
    public function deleteTaskInGraph($userId, $listId, $graphTaskId)
    {
        Log::info('Attempting to delete task in Microsoft Graph', [
            'user_id' => $userId,
            'list_id' => $listId,
            'task_id' => $graphTaskId,
        ]);

        if (! $this->accessToken) {
            Log::error('Access token is missing.');

            return false;
        }

        // تأكد من تعيين الـ access token في كائن graph
        $this->graph->setAccessToken($this->accessToken);

        try {
            $response = $this->graph->createRequest('DELETE', "/users/{$userId}/todo/lists/{$listId}/tasks/{$graphTaskId}")
                ->execute();

            Log::info("Task deleted successfully in Microsoft Graph for user {$userId}.", [
                'task_id' => $graphTaskId,
                'response_status' => $response->getStatus(),
            ]);

            return true;
        } catch (\Microsoft\Graph\Exception\GraphException $e) {
            Log::error("Graph API error deleting task for user {$userId}.", [
                'task_id' => $graphTaskId,
                'error_code' => $e->getCode(),
                'error_message' => $e->getMessage(),
            ]);
        } catch (\Exception $e) {
            Log::error("General error deleting task for user {$userId}.", [
                'task_id' => $graphTaskId,
                'error_code' => $e->getCode(),
                'error_message' => $e->getMessage(),
            ]);
        }

        return false;
    }

